          "rawConfiguration": {
            "facet": {
              "showOtherSeries": false
            },
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "FROM Metric SELECT rate(sum(`vllm:request_success_total`), 1 minute) WHERE instrumentation.provider = 'prometheus' FACET finished_reason TIMESERIES AUTO"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            },
            "legend": {
              "enabled": true
            },
            "yAxisLeft": {
              "zero": true
            }
          }
        },
        {
